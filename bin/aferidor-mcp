#!/usr/bin/env python3
"""aferidor-mcp — expose the household's grocery data to any MCP-capable client.

Speaks the Model Context Protocol over stdio (JSON-RPC 2.0, newline-delimited).
Point a client at it and you can ask, in Portuguese, "onde o arroz está mais
barato?" — the client owns the conversation, the model and the billing; this
server owns the data and the arithmetic.

Standard library only, like the rest of the project. No network calls: it reads
the household repository and shells out to `aferidor`, nothing else.

    Client  ──stdio──>  aferidor-mcp  ──>  bin/aferidor  ──>  plain files

WHY THIS INSTEAD OF A BUILT-IN CHAT
    A chat loop of our own would force every user through a provider API key
    with metered billing in dollars — a developer commercial interface. An MCP
    client rides a normal consumer subscription instead. For the person this
    project was written for, that is the difference between "possible" and
    "not". See docs/explicacao/como-conversar.md.

THE SAFETY BOUNDARY — read this before adding a tool
    This server can read the household's data and append an observed price.
    That is all it can do.

    It cannot open an app, touch the phone, place an order, or pay for
    anything. Those live in `aferidor-fone`, which is deliberately NOT reachable
    from here. Payment is completed by a person, by hand, in the merchant's own
    app — so there is no payment capability for a model to be talked into
    using, no approval token to forge, and no prompt injection worth writing.
    The capability does not exist.

    Keep it that way. If you are about to add a tool that spends money, you are
    about to remove the only property that makes this safe to point a language
    model at.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

VERSION = "0.1.0"

# Versions of the protocol this server knows how to answer. If a client asks
# for something else, we answer with our newest rather than failing — the
# handshake is compatible enough in practice, and refusing strands the user.
PROTOCOL_VERSIONS = ("2025-06-18", "2025-03-26", "2024-11-05")

AFERIDOR = Path(__file__).resolve().parent / "aferidor"


def casa() -> Path:
    """The household repository. AFERIDOR_CASA, or the first parent holding aferidor.toml."""
    start = Path(os.environ.get("AFERIDOR_CASA", os.getcwd())).resolve()
    for candidate in [start, *start.parents]:
        if (candidate / "aferidor.toml").exists():
            return candidate
    return start


def run_aferidor(*args: str) -> tuple[bool, str]:
    """Run the CLI inside the household repository. Returns (ok, output)."""
    try:
        p = subprocess.run(
            [sys.executable, str(AFERIDOR), *args],
            capture_output=True, text=True, timeout=60, cwd=str(casa()),
        )
    except subprocess.TimeoutExpired:
        return False, "aferidor demorou demais para responder (60s)."
    except OSError as exc:
        return False, f"não consegui executar o aferidor: {exc}"
    if p.returncode != 0:
        return False, (p.stderr or p.stdout or "erro desconhecido").strip()
    return True, p.stdout.strip()


def read_file(rel: str, limit: int = 20_000) -> tuple[bool, str]:
    path = casa() / rel
    if not path.exists():
        return False, f"{rel} não existe neste repositório."
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        return False, f"não consegui ler {rel}: {exc}"
    if len(text) > limit:
        text = text[:limit] + f"\n\n[… truncado em {limit} caracteres]"
    return True, text


# ---------------------------------------------------------------------------
# tools
#
# Every tool here either reads the household's files or appends one row to the
# price log. Nothing orders, nothing pays, nothing touches the phone.
# ---------------------------------------------------------------------------

def t_aconselhar(_args: dict) -> tuple[bool, str]:
    ok, out = run_aferidor("advise", "--json")
    if not ok:
        return False, out
    return True, out + (
        "\n\nOs vereditos são MIGRAR, ADOTAR, MANTER e COLETAR. "
        "COLETAR significa que ainda não há amostras suficientes — relate isso "
        "como está, não escolha um vencedor mesmo assim."
    )


def t_comparar(args: dict) -> tuple[bool, str]:
    sku = (args.get("sku") or "").strip()
    if not sku:
        return False, "faltou o parâmetro 'sku'."
    ok, out = run_aferidor("compare", sku, "--json")
    if not ok:
        return False, out + "\n\nUse listar_itens para ver os identificadores disponíveis."
    return True, out


def t_listar(_args: dict) -> tuple[bool, str]:
    root = casa()
    itens = sorted(p.stem for p in (root / "itens").glob("*.md") if not p.stem.startswith("_"))
    mercados = sorted(p.stem for p in (root / "mercados").glob("*.md") if not p.stem.startswith("_"))
    return True, json.dumps({"itens": itens, "mercados": mercados}, ensure_ascii=False, indent=2)


def t_registrar(args: dict) -> tuple[bool, str]:
    for field in ("sku", "mercado", "preco"):
        if not args.get(field):
            return False, f"faltou o parâmetro '{field}'."
    cmd = ["record", str(args["sku"]), str(args["mercado"]), str(args["preco"])]
    if args.get("embalagem"):
        cmd += ["-e", str(args["embalagem"])]
    if args.get("quantidade"):
        cmd += ["-q", str(args["quantidade"])]
    if args.get("marca"):
        cmd += ["-m", str(args["marca"])]
    if args.get("data"):
        cmd += ["-d", str(args["data"])]
    cmd += ["--fonte", str(args.get("fonte") or "manual")]
    ok, out = run_aferidor(*cmd)
    if not ok:
        return False, out
    return True, out + (
        "\n\nRegistrado. Confirme com a pessoa que a embalagem está certa — "
        "é ela que decide a comparação, e um erro aqui não aparece depois."
    )


def t_doutrina(_args: dict) -> tuple[bool, str]:
    ok, text = read_file("AGENTS.md")
    if not ok:
        return False, text
    return True, (
        "As regras desta casa. São autoridade: alergia e veto não se discutem "
        "por preço.\n\n---\n\n" + text
    )


def t_despensa(_args: dict) -> tuple[bool, str]:
    root = casa()
    parts = []
    for path in sorted((root / "despensa").glob("*.md")):
        parts.append(f"## {path.stem}\n\n{path.read_text(encoding='utf-8')}")
    if not parts:
        return False, "não há nada em despensa/ ainda."
    return True, "\n\n".join(parts)


def t_historico(args: dict) -> tuple[bool, str]:
    cmd = ["historico"]
    if args.get("sku"):
        cmd.append(str(args["sku"]))
    if args.get("desde"):
        cmd += ["--desde", str(args["desde"])]
    if args.get("mercado"):
        cmd += ["--mercado", str(args["mercado"])]
    ok, out = run_aferidor(*cmd)
    if not ok:
        return False, out
    return True, out + (
        "\n\nEste é o ritmo de COMPRA, não o de consumo. Promoção, estoque e "
        "viagem mexem nele — não o apresente como quanto a casa consome."
    )


def t_falta(_args: dict) -> tuple[bool, str]:
    ok, out = run_aferidor("falta")
    if not ok:
        return False, out
    return True, out + (
        "\n\nCONFERIR quer dizer 'vá olhar no armário', nunca 'acabou'. Não "
        "invente quantidade restante nem data de término: o programa não sabe "
        "o que existe em casa, só o que foi comprado e quando."
    )


def t_mensagem(args: dict) -> tuple[bool, str]:
    cmd = ["zap"]
    if args.get("sku"):
        cmd.append(str(args["sku"]))
    ok, out = run_aferidor(*cmd)
    if not ok:
        return False, out
    return True, out + (
        "\n\nEste texto NÃO foi enviado, e este servidor não consegue enviá-lo. "
        "Mostre a mensagem à pessoa e deixe que ela decida se manda, e para quem."
    )


def t_mercado(args: dict) -> tuple[bool, str]:
    slug = (args.get("mercado") or "").strip()
    if not slug:
        return False, "faltou o parâmetro 'mercado'."
    ok, text = read_file(f"mercados/{slug}.md")
    if not ok:
        return False, text
    return True, (
        "Perfil do mercado. Frete e pedido mínimo decidem se um desconto é "
        "real — considere-os antes de recomendar trocar de mercado.\n\n---\n\n" + text
    )


def t_diario(_args: dict) -> tuple[bool, str]:
    ok, text = read_file("DIARIO.md")
    if not ok:
        return False, text
    # Tail, not head: the recent decisions are the ones that still apply.
    return True, text[-12_000:]


TOOLS = [
    {
        "name": "aconselhar",
        "description": (
            "O que mudar na compra da casa inteira. Devolve, por item, um veredito: "
            "MIGRAR (trocar de mercado), ADOTAR (definir mercado), MANTER (ficar onde "
            "está) ou COLETAR (faltam amostras). Use quando perguntarem 'o que dá para "
            "economizar?' ou pedirem uma revisão geral. É a visão da cesta toda."
        ),
        "inputSchema": {"type": "object", "properties": {}},
        "handler": t_aconselhar,
    },
    {
        "name": "comparar_preco",
        "description": (
            "Compara os mercados para UM item, com o preço já normalizado por quilo, "
            "litro ou unidade. Use para 'onde o arroz está mais barato?' ou 'vale a "
            "pena comprar no atacarejo?'. Nunca compare os preços de etiqueta você "
            "mesmo: uma garrafa de 900 ml parece mais barata que uma de 1 L e não é."
        ),
        "inputSchema": {
            "type": "object",
            "properties": {"sku": {"type": "string", "description": "identificador do item, ex. 'arroz-tio-joao-1kg'"}},
            "required": ["sku"],
        },
        "handler": t_comparar,
    },
    {
        "name": "listar_itens",
        "description": "Todos os itens e mercados que esta casa acompanha. Use antes de adivinhar um identificador.",
        "inputSchema": {"type": "object", "properties": {}},
        "handler": t_listar,
    },
    {
        "name": "registrar_preco",
        "description": (
            "Anota um preço observado no histórico da casa. Use quando a pessoa disser "
            "quanto custou alguma coisa. O campo 'embalagem' carrega a comparação "
            "inteira: escreva '900ml', '1kg', '6x350ml', 'c/16' — sem ele o preço não "
            "serve para comparar nada."
        ),
        "inputSchema": {
            "type": "object",
            "properties": {
                "sku": {"type": "string", "description": "identificador do item"},
                "mercado": {"type": "string", "description": "identificador do mercado"},
                "preco": {"type": "number", "description": "preço total pago, ex. 7.49"},
                "embalagem": {"type": "string", "description": "'900ml', '1kg', '6x350ml', 'c/16'"},
                "quantidade": {"type": "number", "description": "quantas embalagens (padrão 1)"},
                "marca": {"type": "string"},
                "data": {"type": "string", "description": "AAAA-MM-DD (padrão: hoje)"},
                "fonte": {
                    "type": "string",
                    "enum": ["manual", "nfce", "app", "site", "loja"],
                    "description": "'nfce' é preço pago; 'site'/'app' é preço anunciado",
                },
            },
            "required": ["sku", "mercado", "preco"],
        },
        "handler": t_registrar,
    },
    {
        "name": "ler_doutrina",
        "description": (
            "As regras desta casa: alergias, vetos, marcas aceitas, quem aprova, teto de "
            "gasto. LEIA ANTES de montar qualquer lista ou sugerir substituição. Alergia "
            "é veto absoluto, não preferência negociável por preço."
        ),
        "inputSchema": {"type": "object", "properties": {}},
        "handler": t_doutrina,
    },
    {
        "name": "ler_despensa",
        "description": (
            "O que existe em casa agora, com o ponto de recompra de cada item. Use para "
            "'o que falta?' e para montar a lista. Se o arquivo estiver desatualizado, "
            "diga isso — lista feita sobre despensa velha é ficção com cara de autoridade."
        ),
        "inputSchema": {"type": "object", "properties": {}},
        "handler": t_despensa,
    },
    {
        "name": "ver_historico",
        "description": (
            "O que a casa comprou, por data: gasto por mês e, se você passar um sku, a "
            "linha do tempo daquele item com o intervalo entre as compras. Use para "
            "'quanto gastamos em julho?', 'de quanto em quanto tempo compramos arroz?' "
            "ou antes de opinar se algo está sendo comprado demais."
        ),
        "inputSchema": {
            "type": "object",
            "properties": {
                "sku": {"type": "string", "description": "item, ex. 'oleo-de-soja' (opcional)"},
                "desde": {"type": "string", "description": "data inicial YYYY-MM-DD (opcional)"},
                "mercado": {"type": "string", "description": "filtrar por mercado (opcional)"},
            },
        },
        "handler": t_historico,
    },
    {
        "name": "o_que_falta",
        "description": (
            "Que itens vale a pena conferir no armário, a partir do ritmo de compra e da "
